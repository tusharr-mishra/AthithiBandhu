# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mapbox Configuration
MAPBOX_TOKEN=your_mapbox_token

# Database Configuration
# Online MongoDB Atlas Cluster URL
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.lbkloqs.mongodb.net/AthithiBandhu?retryWrites=true&w=majority

# Local MongoDB Fallback URL (Optional)
MONGO_URL=mongodb://127.0.0.1:27017/AthithiBandhu

# Server & Session Configuration
PORT=8080
SESSION_SECRET=your_super_secret_session_key
NODE_ENV=development
