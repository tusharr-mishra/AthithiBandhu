<nav class="navbar navbar-expand-md sticky-top">
    <div class="container-fluid">

        <!-- Brand Logo & Name -->
        <a class="navbar-brand" href="/listings" aria-label="AthithiBandhu Home">
            <i class="fa-brands fa-airbnb brand-icon"></i>
            <span class="brand-name">AthithiBandhu</span>
        </a>

        <!-- Mobile Toggle Button -->
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarMainCollapse" aria-controls="navbarMainCollapse" aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="navbarMainCollapse">

            <!-- Center Search Bar (Airbnb 3-Segment Capsule) -->
            <form class="navbar-search-pill mx-md-auto my-2 my-md-0" action="/listings" method="GET" role="search"
                aria-label="Search listings by destination">
                <span class="search-segment-btn d-none d-lg-inline">Anywhere</span>
                <span class="search-divider d-none d-lg-inline"></span>
                <span class="search-segment-btn d-none d-lg-inline">Any week</span>
                <span class="search-divider d-none d-lg-inline"></span>
                <div class="search-input-wrap">
                    <input type="text" name="location" class="search-input" placeholder="Search destinations"
                        aria-label="Search destinations" value="<%= typeof location !== 'undefined' ? location : '' %>">
                    <button type="submit" class="search-button" aria-label="Search listings">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>

            <!-- Right Navigation Actions -->
            <div class="navbar-right-actions ms-md-auto mt-3 mt-md-0">
                <% if (!currentUser) { %>
                    <a class="nav-btn nav-btn-outline" href="/listings/new">
                        Airbnb your home
                    </a>

                    <button type="button" class="nav-globe-btn align-self-center"
                        data-bs-toggle="modal" data-bs-target="#languageCurrencyModal"
                        title="Language & Currency" aria-label="Choose language and currency">
                        <i class="fa-solid fa-globe"></i>
                    </button>

                    <a class="nav-btn nav-btn-outline" href="/users/login">
                        Log In
                    </a>

                    <a class="nav-btn nav-btn-primary" href="/users/signup">
                        Sign Up
                    </a>
                <% } else { %>
                    <a class="nav-btn nav-btn-outline" href="/listings/new">
                        Airbnb your home
                    </a>

                    <a class="nav-btn nav-btn-outline" href="/bookings">
                        My Bookings
                    </a>

                    <button type="button" class="nav-globe-btn align-self-center"
                        data-bs-toggle="modal" data-bs-target="#languageCurrencyModal"
                        title="Language & Currency" aria-label="Choose language and currency">
                        <i class="fa-solid fa-globe"></i>
                    </button>

                    <div class="user-badge d-none d-md-inline-flex" title="Active Account">
                        <i class="fa-solid fa-circle-user text-danger"></i>
                        <span><%= currentUser.username || currentUser.name %></span>
                    </div>

                    <form action="/users/logout" method="POST" class="d-inline m-0">
                        <button type="submit" class="nav-btn nav-btn-primary border-0">
                            Log Out
                        </button>
                    </form>
                <% } %>
            </div>

        </div>
    </div>
</nav>