<% layout('/layouts/boilerplate') -%>

<div class="container my-4">
    <div class="row mt-3">
        <div class="col-8 offset-2">

            <h2>Edit Your Review</h2>

            <div class="card mt-3 mb-4">
                <div class="card-body p-4">

                    <form action="/listings/<%= listingId %>/reviews/<%= review._id %>?_method=PUT" method="POST"
                        novalidate class="needs-validation">

                        <div class="mb-4">
                            <label class="form-label d-block">
                                Rating
                            </label>

                            <div class="d-flex gap-4 flex-wrap">
                                <% for (let i=1; i <=5; i++) { %>

                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="review[rating]"
                                            id="rating<%= i %>" value="<%= i %>" <%=Number(review.rating)===i
                                            ? "checked" : "" %>
                                        required
                                        >

                                        <label class="form-check-label" for="rating<%= i %>">
                                            <%= i %>
                                        </label>
                                    </div>

                                    <% } %>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label">
                                Comment
                            </label>

                            <textarea class="form-control" id="comment" name="review[comment]" rows="4"
                                required><%= review.comment %></textarea>

                            <div class="invalid-feedback">
                                Please enter a comment.
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-brand-primary">
                                Save Changes
                            </button>

                            <a href="/listings/<%= listingId %>" class="btn btn-brand-outline">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>